{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
